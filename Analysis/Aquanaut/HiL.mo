          connect(OT1model.p[3], z) annotation(
            Line(points = {{30, 21}, {191.6, 21}, {191.6, 84.3143}, {241.6, 84.3143}}, color = {0, 0, 127}));
          connect(OT1model.v[1], vx) annotation(
