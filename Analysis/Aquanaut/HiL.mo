        Aquanaut.HydroForces.Buoyancy buoyancy2(Cb = 0, dist_keel_cg = 1.758417010307312, outputEnable = false, output_folder = "modelica://Aquanaut/Resources/STL/", shapePath = "modelica://Aquanaut/Resources/STL/Hull - STL Fixed.stl", sphereRadius = 2, time_step = 3, useComplexShape = false, wavePath = "modelica://Aquanaut/Resources/STL/flat_wave_") annotation(
          Placement(transformation(origin = {254, 12}, extent = {{-10, -10}, {10, 10}})));
        Aquanaut.HydroForces.Radiation radiation2(KHeave = 10000, KPitch = 0.1, KSurge = 100, KSway = 0, forwardBW = 1, pressureBW = 0.5, useStream = false) annotation(
