      model simplePI
        parameter Real Kp = 2000;
        parameter Real Ki = 500;
        Modelica.Blocks.Continuous.Integrator integrator annotation(
          Placement(transformation(origin = {-50, -66}, extent = {{-10, -10}, {10, 10}})));
