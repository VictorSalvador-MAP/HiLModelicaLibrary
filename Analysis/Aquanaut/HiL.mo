      Modelica.Blocks.Interfaces.RealOutput y3 annotation(
        Placement(transformation(origin = {66, -64}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {52, -62}, extent = {{-10, -10}, {10, 10}})));
    equation
      connect(y1, derivative.y) annotation(
        Line(points = {{60, 66}, {18, 66}}, color = {0, 0, 127}));
      connect(y2, derivative1.y) annotation(
        Line(points = {{64, 0}, {18, 0}}, color = {0, 0, 127}));
      connect(y3, derivative11.y) annotation(
        Line(points = {{66, -64}, {18, -64}}, color = {0, 0, 127}));
      connect(u1, derivative.u) annotation(
        Line(points = {{-80, 66}, {-20, 66}}, color = {0, 0, 127}));
      connect(u2, derivative1.u) annotation(
        Line(points = {{-80, 0}, {-20, 0}}, color = {0, 0, 127}));
      connect(u3, derivative11.u) annotation(
        Line(points = {{-80, -64}, {-20, -64}}, color = {0, 0, 127}));
    end DerivativeBox;

    function localToWgs84 "Convert absolute local North/East position to WGS84 latitude/longitude"
      input Real originLatitudeDeg(unit = "deg");
      input Real originLongitudeDeg(unit = "deg");
      input Real northM(unit = "m");
      input Real eastM(unit = "m");
      output Real latitudeDeg(unit = "deg");
      output Real longitudeDeg(unit = "deg");
      output Integer status;
    
      external "C" status = wgs84_direct_from_north_east(originLatitudeDeg, originLongitudeDeg, northM, eastM, latitudeDeg, longitudeDeg) annotation(
        Include = "#include \"wgs84_geodesic_wrapper.h\"",
        IncludeDirectory = "modelica://Aquanaut/Resources/Include",
        Library = {"wgs84_geodesic_wrapper", "Geographic", "stdc++", "m"},
        LibraryDirectory = "modelica://Aquanaut/Resources/Library/linux64");
    end localToWgs84;
  end HILUtils;

