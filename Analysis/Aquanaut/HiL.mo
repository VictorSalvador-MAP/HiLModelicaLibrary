        Modelica.Blocks.Interfaces.RealInput propeller_velocity annotation(
          Placement(transformation(origin = {-73, 5}, extent = {{-15, -15}, {15, 15}}), iconTransformation(origin = {10, 2}, extent = {{-20, -20}, {20, 20}})));
      equation
//Variables storage
        derivativeVelx.u = imu.y[4];
        derivativeVely.u = imu.y[5];
        derivativeVelz.u = imu.y[6];
//Accelerometer emulated
//accelX = der(velX) + omegaY(pitch)*velZ(heave) - omegaZ(yaw)*velY(sway) + gravity * sin(pitch)
        accelX = derivativeVelx.y + imu.y[11]*imu.y[6] - imu.y[12]*imu.y[5] + gravity*sin(imu.y[11]);
//accelY = der(velY) + omegaZ(Yaw)*velX(Surge) - omegaX(roll)*velZ(heave) - gravity * sin(roll) * cos(pitch)
        accelY = derivativeVely.y + imu.y[12]*imu.y[4] - imu.y[10]*imu.y[6] - gravity*sin(imu.y[10])*cos(imu.y[11]);
//accelZ = der(velZ) + omegaX(roll)*velY(Sway) - omegaY(pitch)*velX(Surge)
        accelZ = derivativeVelz.y + imu.y[10]*imu.y[5] - imu.y[11]*imu.y[4] - gravity*cos(imu.y[10])*cos(imu.y[11]);
//-------IMU Bias and Noise------
//imu.uncertaintyIn = zeros(24);
//GPS
//bias x
        imu.uncertaintyIn[1] = 0;
//bias y
        imu.uncertaintyIn[2] = 0;
//bias z
        imu.uncertaintyIn[3] = 0;
//Kx
        imu.uncertaintyIn[4] = 0;
//Ky
        imu.uncertaintyIn[5] = 0;
//Kz
        imu.uncertaintyIn[6] = 0;
//bias vx
        imu.uncertaintyIn[7] = 0;
//bias vy
        imu.uncertaintyIn[8] = 0;
//bias vz
        imu.uncertaintyIn[9] = 0;
//Kvx
        imu.uncertaintyIn[10] = 0;
//Kvy
        imu.uncertaintyIn[11] = 0;
//Kvz
        imu.uncertaintyIn[12] = 0;
//Compass
//bias thetaX
        imu.uncertaintyIn[13] = 0;
//bias thetaY
        imu.uncertaintyIn[14] = 0;
//bias thetaZ
        imu.uncertaintyIn[15] = 0;
//KthetaX
        imu.uncertaintyIn[16] = 0.3;
//KthetaY
        imu.uncertaintyIn[17] = 0.3;
//KthetaZ
        imu.uncertaintyIn[18] = 0.3;
//Gyroscope
//bias omegaX
        imu.uncertaintyIn[19] = 0;
//biaz omegaY
        imu.uncertaintyIn[20] = 0;
//bias omegaZ
        imu.uncertaintyIn[21] = 0;
//KomegaX
        imu.uncertaintyIn[22] = 3.3;
//KomegaY
        imu.uncertaintyIn[23] = 3.3;
//KomegaZ
        imu.uncertaintyIn[24] = 3.3;
        connect(marinePropeller.flowSpeed, marineRudder.flowSpeed) annotation(
          Line(points = {{59, 0}, {80.45, 0}, {80.45, -2}, {101.9, -2}, {101.9, -1.8}, {103.9, -1.8}}, color = {0, 0, 127}));
