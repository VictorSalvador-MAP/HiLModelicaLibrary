        Modelica.Blocks.Interfaces.RealOutput vy annotation(
          Placement(transformation(origin = {424, -54}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {292, -142}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput thetaz annotation(
          Placement(transformation(origin = {424, -138}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {322, -168}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput omegax annotation(
          Placement(transformation(origin = {424, -164}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {354, -184}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput omegaY annotation(
          Placement(transformation(origin = {424, -188}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {354, -184}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput omegaz annotation(
          Placement(transformation(origin = {424, -212}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {354, -184}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput rudderFeedback annotation(
          Placement(transformation(origin = {424, -230}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {370, -218}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput ax annotation(
          Placement(transformation(origin = {424, -74}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {702, -322}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput ay annotation(
          Placement(transformation(origin = {424, -96}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {710, -352}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput az annotation(
          Placement(transformation(origin = {424, -118}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {710, -352}, extent = {{-10, -10}, {10, 10}})));
      equation
        connect(switch_v_ref.y, v_e.u1) annotation(
          Line(points = {{51, 86}, {58, 86}}, color = {0, 0, 127}));
        connect(v_e.y, firstOrder.u) annotation(
          Line(points = {{81, 80}, {89, 80}}, color = {0, 0, 127}));
        connect(firstOrder.y, PID_velocity.u) annotation(
          Line(points = {{113, 80}, {130, 80}}, color = {0, 0, 127}));
        connect(and_buo.y, buoFF.S) annotation(
          Line(points = {{-109, 116}, {-34, 116}}, color = {255, 0, 255}));
        connect(booleanConstant.y, buoFF.R) annotation(
          Line(points = {{-75, 96}, {-59.5, 96}, {-59.5, 104}, {-34, 104}}, color = {255, 0, 255}));
