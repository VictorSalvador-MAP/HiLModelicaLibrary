        ShipParts.Hull hull(Ixx = 4599, Iyy = 25870, Izz = 24950, initPos = true, shapeModel = "modelica://Aquanaut/Resources/STL/Hull - STL Fixed.stl", sphereViewer = false, vesselMass = 4110, vesselZ0 = -2) annotation(
