      model IdealGNSSCompass3
        "GNSS Compass model with position, velocity, heading and rate of turn outputs"
      
        Modelica.Mechanics.MultiBody.Sensors.AbsoluteSensor worldSensor(
          get_a = true,
          get_angles = true,
          get_r = true,
