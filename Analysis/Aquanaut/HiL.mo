        Modelica.Blocks.Sources.Constant Wm(k = 400) annotation(
          Placement(transformation(origin = {-66, 4}, extent = {{-10, -10}, {10, 10}})));
        parameter Modelica.Units.SI.Time derivativeFilterTime = 0.01 "Derivative filter time constant";
        parameter Real gravity = Modelica.Constants.g_n "Gravity Acceleration";
        inner Modelica.Mechanics.MultiBody.World world(label2 = "z", n = {0, 0, 1}, enableAnimation = false) annotation(
          Placement(transformation(origin = {-206, -34}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Mechanics.MultiBody.Visualizers.FixedFrame fixedFrame(length = 10, animation = true) annotation(
          Placement(transformation(origin = {-172, -34}, extent = {{-10, -10}, {10, 10}})));
        inner HydroForces.Stream Stream(psiCurr = 0, velocityMean = 1) annotation(
          Placement(transformation(origin = {-186, -68}, extent = {{-10, -10}, {10, 10}})));
        ShipParts.Hull hull(Ixx = 4749.54, Iyx = 213.75, Iyy = 28293.74, Izx = -3411.63, Izy = 15.59, Izz = 27690.71, initPos = true, shapeModel = "modelica://Aquanaut/Resources/STL/Hull_STL_Fixed(Solid)-CM_origin.stl", sphereViewer = false, vesselMass = 4484.75, vesselZ0 = -0.57) annotation(
          Placement(transformation(origin = {242, 32}, extent = {{-10, -10}, {10, 10}})));
        HydroForces.BuoyancyInterpolation buoyancyInterpolation(Cb = 10000, dist_keel_cg = 1.758417010307312, outputEnable = false, output_folder = "modelica://Aquanaut/Resources/STL/", shapePath = "modelica://Aquanaut/Resources/STL/Hull_STL_Fixed(Solid)-CM_origin.stl", sphereRadius = 2, time_step = 10, useComplexShape = true, useSTLPositionXY = true, wavePath = "modelica://Aquanaut/Resources/STL/flat_wave_") annotation(
          Placement(transformation(origin = {242, -8}, extent = {{-10, -10}, {10, 10}})));
        HydroForces.Radiation radiation(useStream = false) annotation(
          Placement(transformation(origin = {242, -44}, extent = {{-10, -10}, {10, 10}})));
        HydroForces.Viscous viscous(Kp = 5000, Mq = 15000, Nr = 10000, Xu = 1000, Yv = 5000, Zw = 5000) annotation(
          Placement(transformation(origin = {242, -84}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput rudderFeedback_rad annotation(
          Placement(transformation(origin = {70, -20}, extent = {{-10, -10}, {10, 10}}, rotation = 180), iconTransformation(origin = {72, -34}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Mechanics.Rotational.Sensors.SpeedSensor propSpeedSensor annotation(
          Placement(transformation(origin = {8, -20}, extent = {{-10, -10}, {10, 10}}, rotation = 180)));
        Modelica.Blocks.Interfaces.RealOutput MainThrusterFeedback_rad_s annotation(
          Placement(transformation(origin = {-44, -20}, extent = {{-10, -10}, {10, 10}}, rotation = 180), iconTransformation(origin = {50, -66}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput z annotation(
          Placement(transformation(origin = {-90, -60}, extent = {{-10, -10}, {10, 10}}, rotation = -90), iconTransformation(origin = {-68, -74}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput omegax annotation(
          Placement(transformation(origin = {86, -60}, extent = {{-10, -10}, {10, 10}}, rotation = -90), iconTransformation(origin = {-14, -80}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput omegaY annotation(
          Placement(transformation(origin = {106, -60}, extent = {{-10, -10}, {10, 10}}, rotation = -90), iconTransformation(origin = {-14, -80}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Interfaces.RealOutput omegaz annotation(
          Placement(transformation(origin = {126, -60}, extent = {{-10, -10}, {10, 10}}, rotation = -90), iconTransformation(origin = {-14, -80}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Continuous.Derivative derivativeVelx(k = 1, T = derivativeFilterTime);
        Modelica.Blocks.Continuous.Derivative derivativeVely(k = 1, T = derivativeFilterTime);
        Modelica.Blocks.Continuous.Derivative derivativeVelz(k = 1, T = derivativeFilterTime);
        output Real accelX(start = 0);
        output Real accelY(start = 0);
        output Real accelZ(start = 0);
      equation
//Variables storage
        derivativeVelx.u = imu.y[4];
        derivativeVely.u = imu.y[5];
        derivativeVelz.u = imu.y[6];
//Accelerometer emulated
//accelX = der(velX) + omegaY(pitch)*velZ(heave) - omegaZ(yaw)*velY(sway) + gravity * sin(pitch)
        accelX = derivativeVelx.y + imu.y[11]*imu.y[6] - imu.y[12]*imu.y[5] + gravity*sin(imu.y[11]);
//accelY = der(velY) + omegaZ(Yaw)*velX(Surge) - omegaX(roll)*velZ(heave) - gravity * sin(roll) * cos(pitch)
        accelY = derivativeVely.y + imu.y[12]*imu.y[4] - imu.y[10]*imu.y[6] - gravity*sin(imu.y[10])*cos(imu.y[11]);
//accelZ = der(velZ) + omegaX(roll)*velY(Sway) - omegaY(pitch)*velX(Surge)
        accelZ = derivativeVelz.y + imu.y[10]*imu.y[5] - imu.y[11]*imu.y[4] - gravity*cos(imu.y[10])*cos(imu.y[11]);
//-------IMU Bias and Noise------
//imu.uncertaintyIn = zeros(24);
//bias x
        imu.uncertaintyIn[1] = 0;
//bias y
        imu.uncertaintyIn[2] = 0;
//bias z
        imu.uncertaintyIn[3] = 0;
//Kx
        imu.uncertaintyIn[4] = 0;
//Ky
        imu.uncertaintyIn[5] = 0;
//Kz
        imu.uncertaintyIn[6] = 0;
//bias vx
        imu.uncertaintyIn[7] = 0;
//bias vy
        imu.uncertaintyIn[8] = 0;
//bias vz
        imu.uncertaintyIn[9] = 0;
//Kvx
        imu.uncertaintyIn[10] = 0;
//Kvy
        imu.uncertaintyIn[11] = 0;
//Kvz
        imu.uncertaintyIn[12] = 0;
//bias thetaX
        imu.uncertaintyIn[13] = 0;
//bias thetaY
        imu.uncertaintyIn[14] = 0;
//bias thetaZ
        imu.uncertaintyIn[15] = 0;
//KthetaX
        imu.uncertaintyIn[16] = 0.3;
//KthetaY
        imu.uncertaintyIn[17] = 0.3;
//KthetaZ
        imu.uncertaintyIn[18] = 0.3;
//bias omegaX
        imu.uncertaintyIn[19] = 0;
//biaz omegaY
        imu.uncertaintyIn[20] = 0;
//bias omegaZ
        imu.uncertaintyIn[21] = 0;
//KomegaX
        imu.uncertaintyIn[22] = 3.3;
//KomegaY
        imu.uncertaintyIn[23] = 3.3;
//KomegaZ
        imu.uncertaintyIn[24] = 3.3;
        connect(marinePropeller.flowSpeed, marineRudder.flowSpeed) annotation(
          Line(points = {{59, 0}, {80.45, 0}, {80.45, -2}, {101.9, -2}, {101.9, -1.8}, {103.9, -1.8}}, color = {0, 0, 127}));
        connect(marinePropeller.flowDiameter, marineRudder.flowDiameter) annotation(
          Line(points = {{59, 4}, {104.9, 4}}, color = {0, 0, 127}));
        connect(marinePropeller.wakeFraction, marineRudder.wakeFraction) annotation(
          Line(points = {{59, 8}, {103.8, 8}, {103.8, 8.2}, {104.8, 8.2}}, color = {0, 0, 127}));
        connect(gain.y, speed.w_ref) annotation(
          Line(points = {{-23.4, 4}, {-8.4, 4}}, color = {0, 0, 127}));
