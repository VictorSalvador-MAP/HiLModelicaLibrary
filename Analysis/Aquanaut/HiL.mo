        ShipParts.Hull hull2(initPos = true, shapeModel = "modelica://Aquanaut/Resources/STL/Hull - STL Fixed.stl", sphereViewer = false, vStart = {0.01, 0, 0}, vesselMass = 4837.59, vesselZ0 = -0.62) annotation(
          Placement(transformation(origin = {254, 52}, extent = {{-10, -10}, {10, 10}})));
        HydroForces.Buoyancy buoyancy2(Cb = 0, dist_keel_cg = 1.758417010307312, outputEnable = false, output_folder = "modelica://Aquanaut/Resources/STL/", shapePath = "modelica://Aquanaut/Resources/STL/Hull - STL Fixed.stl", sphereRadius = 2, time_step = 3, useComplexShape = false, wavePath = "modelica://Aquanaut/Resources/STL/flat_wave_") annotation(
          Placement(transformation(origin = {254, 12}, extent = {{-10, -10}, {10, 10}})));
        HydroForces.Radiation radiation2(KHeave = 10000, KPitch = 0.1, KSurge = 100, KSway = 100, forwardBW = 1, pressureBW = 0.5, useStream = true) annotation(
          Placement(transformation(origin = {254, -28}, extent = {{-10, -10}, {10, 10}})));
        HydroForces.Viscous viscous2(Xu = 1000, Xuu = 1000, Zw = 10000, Zww = 10000, Yv = 100000, useStream = true) annotation(
          Placement(transformation(origin = {254, -64}, extent = {{-10, -10}, {10, 10}})));
        inner Modelica.Mechanics.MultiBody.World world(label2 = "z", n = {0, 0, 1}) annotation(
