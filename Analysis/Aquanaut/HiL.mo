          connect(integrator[3].y, p[6]) annotation(
            Line(points = {{82, -34}, {86, -34}, {86, -24}, {126, -24}}, color = {0, 0, 127}, thickness = 0.5));
          annotation(
            Diagram(graphics = {Rectangle(origin = {77, -10}, lineColor = {85, 85, 255}, lineThickness = 0.75, extent = {{-57, 90}, {57, -90}})}, coordinateSystem(extent = {{-220, -200}, {140, 150}})),
            experiment(StartTime = 0, StopTime = 50, Tolerance = 1e-06, Interval = 0.01),
            __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian -d=fmuExperimental ",
