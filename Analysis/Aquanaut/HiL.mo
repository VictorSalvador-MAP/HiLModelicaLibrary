        Aquanaut.ShipParts.Hull hull2(initPos = true, shapeModel = "modelica://Aquanaut/Resources/STL/Hull - STL Fixed.stl", sphereViewer = false, vStart = {0.01, 0, 0}, vesselMass = 4837.59, vesselZ0 = -0.62) annotation(
