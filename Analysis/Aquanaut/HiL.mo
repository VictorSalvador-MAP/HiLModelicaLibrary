          parameter Real Wp0x = -5000.0;
          parameter Real Wp0y = -10;
          parameter Real Wp1x = 5000.0;
          parameter Real Wp1y = -10;
          // Initialization
          parameter Real initTol = 0.01;
          parameter Real opDelay = 1;
          // Blocks
          OpenLoop OT1model annotation(
