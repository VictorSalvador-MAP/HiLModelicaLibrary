          Documentation(info = "<html><head>
            </head>
            <body>
            <h1>Closed-Loop Path Following Control System</h1>
            
            <p>
              The <em>ClosedLoop</em> model serves as the top-level integration system architecture for the autonomous vehicle model. It pairs an Open-Loop vehicle plant model with look-ahead guidance formulas, velocity regulations, and path-following controllers to build a fully automated, closed-loop navigation infrastructure.
            </p>
            
            <h2>Description</h2>
            
            <p>
              This assembly establishes path trajectory tracking over a waypoint path segment. It features two continuous-time control loops: a <strong>Velocity Controller</strong> that uses a PID layout to adjust propeller speed toward a given velocity target (<code>Uref</code>), and a <strong>Path-Following Controller</strong> that relies on look-ahead angles to determine required rudder angles. 
            </p>
            <p>
              Furthermore, the system embeds state logic configurations (using flip-flops, thresholds, and logic delays) to execute real-time steady-state checks on buoyancy states (Z-axis checks) and initial operating points (X-axis checks), holding back full steering actuation until structural dynamics satisfy the specified initial tolerances.
            </p>
            
            <h2>Parameters</h2>
            
            <table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">
              <caption align=\"bottom\"><strong>Tab. 1:</strong> Parameters of the ClosedLoop integration model</caption>
              <thead>
                <tr bgcolor=\"#f2f2f2\">
                  <th>Name</th>
                  <th>Type</th>
                  <th>Unit</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>pfKp, pfKi, pfKd</strong></td>
                  <td>Real</td>
                  <td>Varies</td>
                  <td>Proportional, Integral, and Derivative gain tunings for the trajectory path-following loop.</td>
                </tr>
                <tr>
                  <td><strong>rudK</strong></td>
                  <td>Real</td>
                  <td>-</td>
                  <td>Static scaling coefficient for the final rudder command mapping.</td>
                </tr>
                <tr>
                  <td><strong>Uref</strong></td>
                  <td>Real</td>
                  <td>m/s</td>
                  <td>Target cruise reference velocity parameter for the vessel.</td>
                </tr>
                <tr>
                  <td><strong>vKp, vKi, vKd</strong></td>
                  <td>Real</td>
                  <td>Varies</td>
                  <td>Proportional, Integral, and Derivative gain tunings for the speed controller loop.</td>
                </tr>
                <tr>
                  <td><strong>Delta</strong></td>
                  <td>Distance</td>
                  <td>m</td>
                  <td>Look-ahead baseline distance utilized inside the Serret-Frenet block.</td>
                </tr>
                <tr>
                  <td><strong>Wp0x, Wp0y</strong></td>
                  <td>Real</td>
                  <td>m</td>
                  <td>Coordinates for the initial waypoint vector (origin boundary).</td>
                </tr>
                <tr>
                  <td><strong>Wp1x, Wp1y</strong></td>
                  <td>Real</td>
                  <td>m</td>
                  <td>Coordinates for the final waypoint vector (destination boundary).</td>
                </tr>
                <tr>
                  <td><strong>initTol</strong></td>
                  <td>Real</td>
                  <td>-</td>
                  <td>Numeric convergence error boundary threshold for state-check logic.</td>
                </tr>
                <tr>
                  <td><strong>opDelay</strong></td>
                  <td>Real</td>
                  <td>s</td>
                  <td>Time-delay filter length used to guarantee operational point stabilization.</td>
                </tr>
              </tbody>
            </table>
            
            <h2>Key Internal Sub-components</h2>
            
            <table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">
              <caption align=\"bottom\"><strong>Tab. 2:</strong> Primary internal block component identifiers</caption>
              <thead>
                <tr bgcolor=\"#f2f2f2\">
                  <th>Instance Name</th>
                  <th>Model Class Type</th>
                  <th>Primary Functional Duty</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>OT1model</strong></td>
                  <td>OpenLoop</td>
                  <td>Represents the physical multi-degree-of-freedom core vehicle plant dynamics.</td>
                </tr>
                <tr>
                  <td><strong>serretFrenet</strong></td>
                  <td>SerretFrenetModel</td>
                  <td>Translates global positions into tracking error vectors based on a target line segment.</td>
                </tr>
                <tr>
                  <td><strong>PID_velocity</strong></td>
                  <td>Modelica.Blocks.Continuous.PID</td>
                  <td>Regulates velocity error signals into physical propeller speed commands.</td>
                </tr>
                <tr>
                  <td><strong>pf_Controller</strong></td>
                  <td>PF_Controller</td>
                  <td>Calculates precise steering corrections based on angular errors.</td>
                </tr>
              </tbody>
            </table>
            
            <h2>System Operation and Interconnections</h2>
            
            <p>
              The system orchestrates multi-loop tracking and control sequences using the following routing criteria:
            </p>
            <ul>
              <li><strong>Velocity Error Loop:</strong> Gathers total velocity <code>U</code> from the Serret-Frenet block, extracts its difference relative to the reference node (or logic switches), dampens it via a <code>FirstOrder</code> block filter, and triggers <code>PID_velocity</code> to spin the physical propellers.</li>
              <li><strong>Path Steering Loop:</strong> Maps position states (<code>p[1]</code>, <code>p[2]</code>) and velocity components (<code>v[1]</code>, <code>v[2]</code>) into the Serret-Frenet framework. Resulting values for tracking profiles (<code>chi_sf</code>, <code>chi_d</code>) traverse safety logic switches to drive the <code>pf_Controller</code>, which sets rudder orientation through <code>controlAlocationGain</code>.</li>
              <li><strong>Buoyancy & Operating Point Interlocks:</strong> Monitors the absolute values and derivatives of vehicle accelerations (<code>a[1]</code> on X-axis and <code>a[3]</code> on Z-axis). Flip-flops prevent reference angles from switching to active modes until transitional oscillations decay below the specified <code>initTol</code>.</li>
            </ul>
            
            </body></html>"));
      end ClosedLoopHiL_Adjusted;

      package Utils
        model SerretFrenetModel "Serret-Frenet Frame Look-Ahead Guidance Law with multiple waypoints"
          // ---------------------------------------------------------------------------
          // Parameters
          // ---------------------------------------------------------------------------
          parameter Integer nWp(min = 2) = 3 "Number of configured waypoints";
          parameter Real Wp[nWp, 2] = [0, 0; 1, -10; 1000, -10] "Waypoint matrix: each row contains [x, y]";
          parameter Modelica.Units.SI.Distance deltaLOS = 10.0 "Look-ahead distance";
          parameter Modelica.Units.SI.Distance waypointAcceptanceRadius[nWp] = fill(2.0, nWp) "Acceptance radius associated with each waypoint";
          parameter Boolean switchWhenPassedWaypoint = false "Switch segment when the vessel passes the target waypoint plane";
          parameter Modelica.Units.SI.Velocity minimumCourseSpeed = 0.01 "Minimum speed required to calculate course from velocity";
          // ---------------------------------------------------------------------------
          // Inputs
          // ---------------------------------------------------------------------------
          Modelica.Blocks.Interfaces.RealInput x "Vessel X position" annotation(
            Placement(transformation(origin = {-111, 59}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {-113, 41}, extent = {{-11, -11}, {11, 11}})));
          Modelica.Blocks.Interfaces.RealInput y "Vessel Y position" annotation(
            Placement(transformation(origin = {-111, 29}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {-113, 11}, extent = {{-11, -11}, {11, 11}})));
          Modelica.Blocks.Interfaces.RealInput vx "Vessel X velocity" annotation(
            Placement(transformation(origin = {-111, -31}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {-113, -49}, extent = {{-11, -11}, {11, 11}})));
          Modelica.Blocks.Interfaces.RealInput vy "Vessel Y velocity" annotation(
            Placement(transformation(origin = {-111, -61}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {-113, -79}, extent = {{-11, -11}, {11, 11}})));
          Modelica.Blocks.Interfaces.RealInput psi "Vessel Z orientation" annotation(
            Placement(transformation(origin = {-111, -1}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {-113, -19}, extent = {{-11, -11}, {11, 11}})));
          // ---------------------------------------------------------------------------
          // Guidance outputs
          // ---------------------------------------------------------------------------
          Modelica.Blocks.Interfaces.RealOutput chi_sf "Path angle to vessel course error" annotation(
            Placement(transformation(origin = {111, 1}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {171, -21}, extent = {{-11, -11}, {11, 11}})));
          Modelica.Blocks.Interfaces.RealOutput chi_d "LOS angle correction" annotation(
            Placement(transformation(origin = {111, -39}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {171, -61}, extent = {{-11, -11}, {11, 11}})));
          Modelica.Blocks.Interfaces.RealOutput U "Vessel speed magnitude" annotation(
            Placement(transformation(origin = {111, 39}, extent = {{-11, -11}, {11, 11}}), iconTransformation(origin = {171, 17}, extent = {{-11, -11}, {11, 11}})));
          // ---------------------------------------------------------------------------
          // Route status outputs
          // ---------------------------------------------------------------------------
          Modelica.Blocks.Interfaces.IntegerOutput activeSegment "Current path segment index";
          Modelica.Blocks.Interfaces.IntegerOutput activeWaypoint "Current target waypoint index";
          Modelica.Blocks.Interfaces.BooleanOutput missionFinished "True after reaching the final waypoint";
          Modelica.Blocks.Interfaces.RealOutput targetX "Current target waypoint X coordinate";
          Modelica.Blocks.Interfaces.RealOutput targetY "Current target waypoint Y coordinate";
          // ---------------------------------------------------------------------------
          // Public diagnostic variables
          // ---------------------------------------------------------------------------
          Real e_y "Signed cross-track error";
          Real psi_sf "Path heading to vessel heading error";
          Real alongTrack "Distance projected along the active path segment";
          Real distanceToTarget "Euclidean distance to the active target waypoint";
        protected
          // ---------------------------------------------------------------------------
          // Discrete route state
          // ---------------------------------------------------------------------------
          discrete Integer segmentIndex(start = 1, fixed = true) "Index of the starting waypoint of the active segment";
          discrete Boolean completed(start = false, fixed = true) "Latched route completion state";
          // ---------------------------------------------------------------------------
          // Active path geometry
          // ---------------------------------------------------------------------------
          Real startX "Active segment starting waypoint X";
          Real startY "Active segment starting waypoint Y";
          Real dx "Active path segment delta X";
          Real dy "Active path segment delta Y";
          Real segmentLength "Length of the active path segment";
          Real psi_p "Heading angle of the active path segment";
          Real bx "Vessel X position relative to the segment start";
          Real by "Vessel Y position relative to the segment start";
          Real chi "Vessel course angle";
          Modelica.Units.SI.Distance activeAcceptanceRadius "Acceptance radius of the current target waypoint";
          Boolean waypointReached "True while the vessel is inside the target acceptance radius";
          Boolean waypointPassed "True after the vessel passes the target waypoint plane";
        public
        initial equation
          assert(nWp >= 2, "SerretFrenetModel requires at least two waypoints.");
// Check the complete waypoint table during initialization.
          for i in 1:(nWp - 1) loop
            assert((Wp[i + 1, 1] - Wp[i, 1])^2 + (Wp[i + 1, 2] - Wp[i, 2])^2 > 1e-12, "Consecutive waypoints must not have identical coordinates.");
          end for;
        equation
// ---------------------------------------------------------------------------
// Active waypoint selection
// ---------------------------------------------------------------------------
          startX = Wp[segmentIndex, 1];
          startY = Wp[segmentIndex, 2];
          targetX = Wp[segmentIndex + 1, 1];
          targetY = Wp[segmentIndex + 1, 2];
          activeSegment = segmentIndex;
          activeWaypoint = segmentIndex + 1;
          missionFinished = completed;
// The acceptance radius entry follows the target waypoint index.
          activeAcceptanceRadius = waypointAcceptanceRadius[segmentIndex + 1];
// ---------------------------------------------------------------------------
// Active segment geometry
// ---------------------------------------------------------------------------
          dx = targetX - startX;
          dy = targetY - startY;
          segmentLength = sqrt(dx^2 + dy^2);
          psi_p = Modelica.Math.atan2(dy, dx);
// Vessel position relative to the starting waypoint of the active segment.
          bx = x - startX;
          by = y - startY;
// ---------------------------------------------------------------------------
// Vessel kinematics
// ---------------------------------------------------------------------------
          U = sqrt(vx^2 + vy^2);
// At very low speed, course calculated from velocity is unreliable.
// Vessel heading is used as a fallback.
          chi = noEvent(if U > minimumCourseSpeed then Modelica.Math.atan2(vy, vx) else psi);
// ---------------------------------------------------------------------------
// Serret-Frenet coordinates
// ---------------------------------------------------------------------------
// Signed cross-track error.
          e_y = -Modelica.Math.sin(psi_p)*bx + Modelica.Math.cos(psi_p)*by;
// Position projected along the active segment.
          alongTrack = Modelica.Math.cos(psi_p)*bx + Modelica.Math.sin(psi_p)*by;
// ---------------------------------------------------------------------------
// Guidance outputs
// ---------------------------------------------------------------------------
          psi_sf = psi_p - psi;
          chi_sf = psi_p - chi;
          chi_d = Modelica.Math.atan2(e_y, deltaLOS);
// ---------------------------------------------------------------------------
// Waypoint transition conditions
// ---------------------------------------------------------------------------
          distanceToTarget = sqrt((x - targetX)^2 + (y - targetY)^2);
          waypointReached = distanceToTarget <= activeAcceptanceRadius;
          waypointPassed = alongTrack >= segmentLength;
        algorithm
// ---------------------------------------------------------------------------
// Route state machine
// ---------------------------------------------------------------------------
          when initial() then
            segmentIndex := 1;
            completed := false;
          elsewhen not pre(completed) and (waypointReached or (switchWhenPassedWaypoint and waypointPassed)) then
            if pre(segmentIndex) < nWp - 1 then
// Start following the next line segment.
              segmentIndex := pre(segmentIndex) + 1;
              completed := false;
            else
// The target of the current segment is the final waypoint.
              segmentIndex := pre(segmentIndex);
              completed := true;
            end if;
          end when;
          annotation(
            Documentation(info = "<html>
        <h1>Multi-waypoint Serret-Frenet LOS Guidance</h1>
        
        <p>
        The block follows a piecewise-linear route defined by an ordered waypoint
        matrix. Each consecutive waypoint pair defines one path segment.
        </p>
        
        <p>
        The active segment starts as Wp[1,:] to Wp[2,:]. After reaching the target
        waypoint acceptance radius, the model advances to the next segment.
        </p>
        
        <p>
        The optional switchWhenPassedWaypoint parameter allows the route manager to
        advance after the vessel crosses the plane perpendicular to the path at the
        target waypoint.
        </p>
        </html>"),
            Diagram(graphics = {Bitmap(origin = {-299, 133}, extent = {{1, -3}, {-1, 3}})}, coordinateSystem(extent = {{-120, -100}, {180, 60}})),
            Icon(coordinateSystem(extent = {{-120, -100}, {180, 60}}), graphics = {Rectangle(origin = {30, -23}, fillColor = {255, 255, 255}, fillPattern = FillPattern.Solid, lineThickness = 1.5, extent = {{-130, 71}, {130, -71}}), Text(origin = {30, 40}, extent = {{-130, 8}, {130, -8}}, textString = "Serret-Frenèt with LOS"), Line(origin = {40.89, -54.11}, points = {{-90.8927, -25.8927}, {91.1073, 20.1073}}, pattern = LinePattern.Dash, thickness = 1.25), Ellipse(origin = {-50, -80}, fillPattern = FillPattern.Solid, extent = {{-4, 4}, {4, -4}}), Ellipse(origin = {130, -34}, fillPattern = FillPattern.Solid, extent = {{-4, 4}, {4, -4}}), Polygon(origin = {18, 10}, rotation = -90, fillColor = {255, 0, 0}, pattern = LinePattern.Dash, fillPattern = FillPattern.Solid, lineThickness = 1, points = {{-10, -30}, {10, -30}, {10, -6}, {0, 8}, {-10, -6}, {-10, -6}, {-10, -30}}), Polygon(origin = {36, -58}, rotation = 270, lineColor = {170, 0, 0}, fillColor = {255, 0, 0}, pattern = LinePattern.Dash, lineThickness = 1, points = {{-1.13632, -29.611}, {17.6575, -24.7706}, {11.449, -2.21795}, {-0.73616, 3.51754}, {-7.34481, -7.05836}, {-7.34481, -7.05836}, {-1.13632, -29.611}}), Ellipse(origin = {4, 10}, fillPattern = FillPattern.Solid, extent = {{-4, 4}, {4, -4}}), Ellipse(origin = {22, -62}, fillPattern = FillPattern.Solid, extent = {{-4, 4}, {4, -4}}), Line(origin = {21.05, -25.6}, points = {{-17.0536, 35.5967}, {0.946364, -36.4033}}, pattern = LinePattern.Dash, thickness = 0.5), Line(origin = {21.05, -25.6}, points = {{-17.0536, 35.5967}, {70.9464, -18.4033}}, color = {170, 0, 127}, pattern = LinePattern.Dash, thickness = 0.5), Text(origin = {62, -62}, rotation = 15, extent = {{-9, -7}, {9, 7}}, textString = "Delta"), Line(origin = {59, -58}, points = {{-35, -10}, {35, 10}}, thickness = 0.5, arrow = {Arrow.Filled, Arrow.Filled}), Text(origin = {-61, -68}, extent = {{-9, 6}, {9, -6}}, textString = "Wp0"), Text(origin = {135, -22}, extent = {{-9, 6}, {9, -6}}, textString = "Wp1")}));
        end SerretFrenetModel;
      end Utils;

      model ClosedLoopHiL_Adjusted_multiWaypoints
        // Parameters for Closed Loop
        // Path Following Control
        parameter Real pfKp = 0.046;
        parameter Real pfKi = 0.001;
        parameter Real pfKd = 0.533;
        parameter Real rudK = 1.0;
        // Velocity Control
        parameter Real Uref = 5.0;
        parameter Real vKp = 0.963242207995077;
        parameter Real vKi = 1.932793587;
        parameter Real vKd = 0.051946887;
        // Serret-Frenet
        parameter Modelica.Units.SI.Distance Delta = 10 "LOS look-ahead distance";
        parameter Integer nWp(min = 2) = 2 "Number of configured path points";
        parameter Real Wp[nWp, 2] = [15, -10; 5000, -10] "Waypoint matrix: each row contains [x, y] in meters";
        parameter Modelica.Units.SI.Distance waypointAcceptanceRadius[nWp] = {2.0, 2.0} "Acceptance radius associated with each waypoint";
        parameter Boolean switchWhenPassedWaypoint = false "Advance only after reaching the waypoint acceptance radius";
        // Initialization
        parameter Real initTol = 0.01;
        parameter Real opDelay = 1;
        // Blocks
        OpenLoop OT1model annotation(
          Placement(transformation(origin = {230, 30}, extent = {{-30, -30}, {30, 30}})));
        PathFollowingTests.Utils.SerretFrenetModel serretFrenet(nWp = nWp, Wp = Wp, deltaLOS = Delta, waypointAcceptanceRadius = waypointAcceptanceRadius, switchWhenPassedWaypoint = switchWhenPassedWaypoint) annotation(
          Placement(transformation(origin = {-272.125, -11.2663}, extent = {{-44.875, -23.9334}, {44.875, 23.9334}})));
        Modelica.Blocks.Logical.Switch switch_v_ref annotation(
          Placement(transformation(origin = {40, 86}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Continuous.PID PID_velocity(Ti = vKp/vKi, Td = vKd/vKp) annotation(
          Placement(transformation(origin = {142, 80}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Sources.Constant u_op(k = Uref) annotation(
          Placement(transformation(origin = {44, 138}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Math.Add v_e(k2 = -1) annotation(
          Placement(transformation(origin = {70, 80}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Logical.And and_buo annotation(
          Placement(transformation(origin = {-120, 116}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Math.Abs abs_az annotation(
          Placement(transformation(origin = {-214, 116}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Math.Abs abs_daz annotation(
          Placement(transformation(origin = {-214, 82}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Logical.LessThreshold th_daz(threshold = initTol) annotation(
          Placement(transformation(origin = {-178, 82}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Logical.LessThreshold th_az(threshold = initTol) annotation(
          Placement(transformation(origin = {-178, 116}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Continuous.FirstOrder firstOrder(T = 0.1) annotation(
          Placement(transformation(origin = {102, 80}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Continuous.Derivative der_az annotation(
          Placement(transformation(origin = {-246, 82}, extent = {{-10, -10}, {10, 10}}, rotation = -0)));
        Modelica.Blocks.Logical.RSFlipFlop buoFF annotation(
          Placement(transformation(origin = {-22, 110}, extent = {{-10, -10}, {10, 10}})));
        Modelica.Blocks.Sources.BooleanConstant booleanConstant(k = false) annotation(
