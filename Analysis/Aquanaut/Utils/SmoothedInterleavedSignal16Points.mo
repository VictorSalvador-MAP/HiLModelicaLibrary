within Aquanaut.Utils;

model SmoothedInterleavedSignal16Points
  Modelica.Blocks.Interfaces.RealOutput CiclicContinuousOutput annotation(
    Placement(transformation(origin = {110, 0}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {110, 0}, extent = {{-10, -10}, {10, 10}})));
  
  parameter Real frequencyTime = 1;
  //change after each 1 second (originally)
  parameter Real valueOutput[16] = linspace(-0.85, -0.45, 16);
  //(originally with HeaveValues)
  parameter Real tau = 0.05;
  //Low-pass Period
  Integer index;

  Real smoothedSignal(start = valueOutput[1]);

  equation
    index = integer(mod(noEvent(floor(time/frequencyTime)), size(valueOutput, 1))) + 1;
  
    //Smooth signal with low-pass filter
    der(smoothedSignal) = (valueOutput[index] - smoothedSignal)/tau;
  
    //Output smoothed Signal attribution
    CiclicContinuousOutput = smoothedSignal;
    
    annotation(
    uses(Modelica(version = "4.1.0")),
    experiment(StartTime = 0, StopTime = 16, Tolerance = 1e-06, Interval = 0.032),
    __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --maxSizeLinearization=6000 --fmuRuntimeDepends=modelica ",
    __OpenModelica_simulationFlags(lv = "LOG_STDOUT,LOG_ASSERT,LOG_STATS", s = "cvode", variableFilter = ".*"),
    Icon(graphics = {Rectangle(fillColor = {85, 0, 255}, fillPattern = FillPattern.Solid, extent = {{-100, 100}, {100, -100}}), Rectangle(origin = {-79, -63}, fillPattern = FillPattern.Solid, extent = {{-21, 5}, {21, -5}}), Rectangle(origin = {65, -69}, fillPattern = FillPattern.Solid, extent = {{-21, 5}, {21, -5}}), Rectangle(origin = {17, 5}, fillPattern = FillPattern.Solid, extent = {{-21, 5}, {21, -5}}), Rectangle(origin = {-33, -29}, fillPattern = FillPattern.Solid, extent = {{-21, 5}, {21, -5}}), Rectangle(origin = {-56, -46}, fillPattern = FillPattern.Solid, extent = {{-4, -22}, {4, 22}}), Rectangle(origin = {-8, -12}, fillPattern = FillPattern.Solid, extent = {{-4, -22}, {4, 22}}), Rectangle(origin = {40, -32}, fillPattern = FillPattern.Solid, extent = {{-4, -42}, {4, 42}}), Text(origin = {-13, 115}, extent = {{-87, 21}, {87, -21}}, textString = "%name"), Bitmap(origin = {9, -1}, extent = {{-119, -101}, {119, 101}}, imageSource = ""), Text(origin = {1, -78}, extent = {{-75, 14}, {75, -14}}, textString = "16 Nodal Points Reference", textStyle = {TextStyle.Bold})}),
    Diagram);
end SmoothedInterleavedSignal16Points;